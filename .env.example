# Use a unique, strong password for the temporary RSVP dashboard.
PUJA_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Generate at least 32 random characters, for example: openssl rand -base64 48
PUJA_SESSION_SECRET=replace-with-at-least-32-random-characters

# Added automatically when a private Vercel Blob store is connected to the project.
# Pull it for local development with: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
